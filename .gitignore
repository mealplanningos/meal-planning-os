# Meal Planning OS — gitignore
# Added 2026-05-11 as part of pre-pentest hardening.
# Existing tracked files are NOT affected by adding rules here —
# this only prevents future accidents.

# ── Secrets (never commit env files) ─────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# ── OS / editor noise ────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ── Node / build ─────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Netlify CLI local cache ──────────────────────────────────
.netlify/

# ── Local deploy artifacts ───────────────────────────────────
deploy-*.zip

# ── Local backup copies (already tracked ones stay tracked) ──
.backups/

# ── Local test harnesses (one-off Phase 2 testing, can delete) ──
.test-*.js
